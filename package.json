{
    "name": "hadiwa",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "npm run db:create || true && npm run migrate && npm run seed && babel-node index.js",
        "start:prod": "npm run migrate && npm run seed && node dist/index.js",
        "build": "babel . --ignore node_modules,dist --out-dir dist",
        "dev": "NODE_ENV=development npm run db:create || true && npm run migrate && npm run seed && nodemon index.js --exec babel-node",
        "test": "NODE_ENV=test npm run setup:test && NODE_ENV=test mocha --require @babel/register ./Backend/tests --timeout 10000 --exit",
        "db:create": "./node_modules/.bin/sequelize db:create",
        "db:create:test": "cross-env NODE_ENV=test ./node_modules/.bin/sequelize db:create",
        "db:drop": "./node_modules/.bin/sequelize db:drop",
        "db:drop:test": "cross-env NODE_ENV=test ./node_modules/.bin/sequelize db:drop",
        "coveralls": "nyc npm test && nyc report --reporter=text-lcov | coveralls && nyc --reporter=lcov --reporter=text-lcov npm test",
        "setup:test": "cross-env NODE_ENV=test npm run migrate:undo && cross-env NODE_ENV=test npm run migrate && cross-env NODE_ENV=test npm run seed",
        "migrate": "./node_modules/.bin/sequelize db:migrate",
        "seed": "node_modules/.bin/sequelize db:seed:all",
        "seed:undo": "node_modules/.bin/sequelize db:seed:undo:all",
        "migrate:undo": "./node_modules/.bin/sequelize db:migrate:undo:all"
    },
    "author": "Celestin Niyonsaba",
    "license": "ISC",
    "devDependencies": {
        "@types/body-parser": "^1.19.6",
        "@types/express": "^5.0.6",
        "coveralls": "^3.1.1",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.31.0",
        "mocha": "^11.1.0",
        "nodemon": "^3.1.14",
        "nyc": "^17.1.0"
    },
    "dependencies": {
        "@babel/cli": "^7.26.4",
        "@babel/core": "^7.26.9",
        "@babel/node": "^7.26.0",
        "@babel/polyfill": "^7.12.1",
        "@babel/preset-env": "^7.26.9",
        "@babel/register": "^7.25.9",
        "@sendgrid/mail": "^8.1.6",
        "algoliasearch": "^5.21.0",
        "bcryptjs": "^3.0.3",
        "bluebird": "^3.7.2",
        "body-parser": "^1.20.4",
        "chai": "^6.2.2",
        "chai-http": "^5.1.2",
        "concurrently": "^9.2.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.2",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "path": "^0.12.7",
        "pg": "^8.20.0",
        "pg-hstore": "^2.3.4",
        "redis": "^5.11.0",
        "response-time": "^2.3.4",
        "sequelize": "^6.37.8",
        "sequelize-cli": "^6.6.5",
        "socket.io": "^4.8.3",
        "stripe": "^22.0.1",
        "uuidv4": "^6.2.13"
    }
}
